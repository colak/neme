<script>
let popup = document.getElementById("footnote-popup");
popup || (popup = document.createElement("div"), popup.id = "footnote-popup", document.body.appendChild(popup));
const footnoteRefs = document.querySelectorAll(".footnote-ref a"),
    POPUP_PADDING = 10,
    VIEWPORT_MARGIN = 20,
    ALLOWED_TAGS = ["P", "CITE", "A", "EM", "I", "STRONG", "B", "SUP", "SUB", "DEL", "INS", "S", "KBD", "SPAN", "BR", "WBR", "Q", "MARK", "ABBR", "DFN", "TIME", "BLOCKQUOTE", "DL", "DT", "DD", "BDI", "BDO"],
    ALLOWED_ATTRIBUTES = {
        A: ["href", "title", "rel", "lang"],
        SPAN: ["lang", "class"],
        TIME: ["datetime"],
        BLOCKQUOTE: ["cite"],
        Q: ["cite"],
        ABBR: ["title"],
        BDI: ["dir"],
        BDO: ["dir"]
    };

function validateHref(e) {
    return !(!e || "string" != typeof e || !e.startsWith("#")) && /^#[a-zA-Z0-9_:.-]+$/.test(e)
}

function validateLinkHref(e) {
    if (!e || "string" != typeof e) return !1;
    const t = e.trim();
    if (t.startsWith("#")) return /^#[a-zA-Z0-9_:.-]+$/.test(t);
    try {
        const e = new URL(t, window.location.origin);
        return "http:" === e.protocol || "https:" === e.protocol
    } catch {
        return !1
    }
}

function validateCite(e) {
    if (!e || "string" != typeof e) return !1;
    const t = e.trim();
    if (t.startsWith("#")) return /^#[a-zA-Z0-9_:.-]+$/.test(t);
    try {
        const e = new URL(t, window.location.origin);
        return "http:" === e.protocol || "https:" === e.protocol
    } catch {
        return !1
    }
}

function sanitizeElement(e) {
    const t = e.tagName.toUpperCase();
    if (!ALLOWED_TAGS.includes(t)) {
        const t = document.createDocumentFragment();
        return e.childNodes.forEach(e => {
            if (e.nodeType !== Node.TEXT_NODE) {
                if (e.nodeType === Node.ELEMENT_NODE) {
                    const o = sanitizeElement(e);
                    o && t.appendChild(o)
                }
            } else t.appendChild(e.cloneNode(!0))
        }), t
    }
    const o = e.cloneNode(!1),
        n = ALLOWED_ATTRIBUTES[t] || [];
    return Array.from(e.attributes).forEach(e => {
        const i = e.name.toLowerCase(),
            p = e.value;
        "id" !== i && "name" !== i && n.includes(i) && ("A" !== t || "href" !== i || validateLinkHref(p)) && ("Q" !== t && "BLOCKQUOTE" !== t || "cite" !== i || validateCite(p)) && o.setAttribute(i, p)
    }), e.childNodes.forEach(e => {
        if (e.nodeType !== Node.TEXT_NODE) {
            if (e.nodeType === Node.ELEMENT_NODE) {
                const t = sanitizeElement(e);
                t && o.appendChild(t)
            }
        } else o.appendChild(e.cloneNode(!0))
    }), o
}

function positionPopup(e) {
    const t = popup.getBoundingClientRect(),
        o = e.getBoundingClientRect(),
        n = window.innerWidth,
        i = "absolute" === window.getComputedStyle(popup).position,
        p = i ? window.scrollY : 0,
        l = i ? window.scrollX : 0;
    let u = o.top + p - t.height - 10,
        r = o.left + l;
    o.top - t.height - 10 < 0 && (u = o.bottom + p + 10), r + t.width > n && (r = n - t.width - 20), r < 20 && (r = 20), popup.style.top = `${u}px`, popup.style.left = `${r}px`
}

function showPopup(e) {
    const t = e.getAttribute("href");
    if (!validateHref(t)) return console.error("Invalid footnote reference:", t), !1;
    const o = document.getElementById(t.slice(1));
    if (!o) return console.error("Footnote element not found:", t), !1;
    const n = o.cloneNode(!0);
    n.querySelectorAll(".footnote-back").forEach(e => e.remove());
    const i = sanitizeElement(n);
    return popup.replaceChildren(), i && popup.appendChild(i), popup.style.display = "block", popup.classList.add("show"), positionPopup(e), !0
}

function hidePopup() {
    popup.style.display = "none", popup.classList.remove("show")
}

function handlePopupScroll(e) {
    if ("none" === popup.style.display) return;
    const t = popup.getBoundingClientRect();
    if (!(e.clientX >= t.left && e.clientX <= t.right && e.clientY >= t.top && e.clientY <= t.bottom)) return;
    if (popup.scrollHeight <= popup.clientHeight) return;
    const o = popup.scrollTop,
        n = popup.scrollHeight,
        i = popup.clientHeight,
        p = e.deltaY;
    p < 0 && o <= 0 || p > 0 && o + i >= n - 1 || (e.preventDefault(), e.stopPropagation(), popup.scrollTop += p)
}
const isTouchDevice = "ontouchstart" in window || navigator.maxTouchPoints > 0;
let pendingCloseTimeout = null,
    mouseIsInsidePopup = !1;
isTouchDevice || (footnoteRefs.forEach(e => {
    e.addEventListener("mouseenter", () => {
        showPopup(e), pendingCloseTimeout && (clearTimeout(pendingCloseTimeout), pendingCloseTimeout = null)
    }), e.addEventListener("mouseleave", () => {
        pendingCloseTimeout = setTimeout(() => {
            mouseIsInsidePopup || hidePopup(), pendingCloseTimeout = null
        }, 50)
    })
}), popup.addEventListener("mouseenter", () => {
    mouseIsInsidePopup = !0, pendingCloseTimeout && (clearTimeout(pendingCloseTimeout), pendingCloseTimeout = null)
}), popup.addEventListener("mouseleave", () => {
    mouseIsInsidePopup = !1
}), popup.addEventListener("wheel", handlePopupScroll, {
    passive: !1
}));
let activePopupLink = null;
isTouchDevice && footnoteRefs.forEach(e => {
    e.addEventListener("click", t => {
        if (t.preventDefault(), activePopupLink === e) return hidePopup(), void(activePopupLink = null);
        hidePopup(), showPopup(e) && (activePopupLink = e)
    })
}), document.addEventListener("click", e => {
    const t = e.target instanceof Element ? e.target : null;
    if (!t) return;
    const o = t.closest(".footnote-ref"),
        n = t.closest("#footnote-popup");
    o || n || (hidePopup(), activePopupLink = null)
}), document.addEventListener("keydown", e => {
    "Escape" === e.key && (hidePopup(), pendingCloseTimeout && (clearTimeout(pendingCloseTimeout), pendingCloseTimeout = null), activePopupLink = null)
}), document.querySelectorAll(".footnote-back").forEach(e => {
    e.addEventListener("click", t => {
        t.preventDefault();
        const o = e.getAttribute("href");
        if (!validateHref(o)) return void console.error("Invalid footnote back-reference:", o);
        const n = document.getElementById(o.slice(1));
        if (n) {
            try {
                window.location.hash = o
            } catch (e) {
                console.warn("Could not update URL hash:", e)
            }
            n.scrollIntoView({
                behavior: "smooth",
                block: "start"
            }), hidePopup(), activePopupLink = null
        }
    })
});
</script>


