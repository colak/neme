<txp:article_custom status section form="" listform="" section="projects" label='More ' labeltag="h4" limit="999" c10="x" class="submenu">

    <!-- Step 1: Detect a new year and open/close the accordion wraps -->
    <txp:if_different>
        <!-- Close the previous list and details tags if this isn't the first article -->
        <txp:if_first_article><txp:else />
                </ul>
            </details>
        </txp:if_first_article>

        <!-- Open the new year's accordion -->
        <details class="year-accordion">
            <summary class="year-heading"><txp:posted format="%Y" /></summary>
            <ul class="article-list">
    </txp:if_different>

    <!-- Step 2: Output individual article list items -->
    <li>
        <txp:if_article_category>
            <txp:if_custom_field name="status" value="5">
                <a href="/<txp:section />/<txp:category1 />/" rel="bookmark"><txp:title /></a>
            </txp:if_custom_field>
        <txp:else />
            <txp:if_article_id>
                <span><txp:title /></span>
            <txp:else />
                <a href="<txp:permlink />" rel="bookmark"><txp:title /></a>
            </txp:if_article_id>
        </txp:if_article_category>
    </li>

    <!-- Step 3: Clean up and close the final tags at the very end -->
    <txp:if_last_article>
            </ul>
        </details>
    </txp:if_last_article>

</txp:article_custom>
