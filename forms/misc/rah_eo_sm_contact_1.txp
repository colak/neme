<!doctype html>
<head>
<meta charset="utf-8">
<meta name="ROBOTS" content="NOINDEX, NOFOLLOW"/>
<meta name="GOOGLEBOT" content="NOARCHIVE"> 

<style>
label, legend, .zemError {font-size:12px;font-family: sans-serif; -ms-text-size-adjust: 60%; -webkit-text-size-adjust: 60%;clear:both;display:block;}
fieldset {width:90%;clear:both;display:block;}
input, zemTextarea, #Message {width:90%;clear:both;display:block;} 
select {margin-bottom:1em;}
</style>

</head>
<body>

<txp:zem_contact to_form="my_zem_contact_to_form" subject="State_Machines_Inquiry" thanks="Thank you, your message has been sent.">
<txp:zem_contact_textarea label="Message" required="1" /><br>
<txp:zem_contact_text label="Name" required="1" /><br>
<txp:zem_contact_text label="Surname" required="1" /><br>
<txp:zem_contact_email label="Email" name="Email" required="1" /><br>
<txp:zem_contact_text label="Website" required="0" /><br>
<txp:zem_contact_select name="Organisation" label="Select organisation you wish to contact" options=",Project coordinator,Aksioma,Drugo More,Furtherfield,Institute of Network Cultures,NeMe" /><br>
<txp:zem_contact_checkbox label="To prove that this is not spam, check this box before clicking the send button." /><br>
<txp:zem_contact_serverinfo name="REMOTE_ADDR" label="IP number" />
<txp:zem_contact_serverinfo name="HTTP_USER_AGENT" label="Browser" />
<txp:zem_contact_submit label="Send" />
</txp:zem_contact>
</body>
</html>